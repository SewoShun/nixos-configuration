; Listeners that run scripts from the Nix store (generated by modules/programs/eww.nix)
(include "./listeners.yuck")

; Vertical bar on the left of each monitor, opened by eww-bar (config/eww-scripts/bar.sh)
; with the monitor's name, whether the host is a laptop and whether the monitor is the
; primary one (host.json) as its arguments.
(defwindow bar [monitor laptop primary]
  :monitor monitor
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "44px"
                      :height "100%"
                      :anchor "left center")
  :stacking "fg"
  :exclusive true
  :focusable "none"
  :namespace "eww-bar"
  (bar :monitor monitor :laptop laptop :primary primary))

(defwidget bar [monitor laptop primary]
  (box :class "bar"
       :orientation "v"
       :space-evenly false
    (box :orientation "v"
         :space-evenly false
         :spacing 16
         :vexpand true
      (workspaces :monitor monitor)
      (datetime)
      (volume)
      ; a desktop has no backlight and no battery
      (box :visible laptop (brightness))
      (box :visible laptop (battery))
      (network))
    ; a tray can be shown on one monitor only
    (box :visible primary (tray))))

; Icons only: the tray is never clicked (ADR-0002), so it is made insensitive and
; eww's activate and menu handlers never fire
(defwidget tray []
  (box :class "tray"
       :active false
    (systray :orientation "v"
             :space-evenly false
             :spacing 8
             :icon-size 20)))

; workspaces holds the workspaces of every output (config/eww-scripts/workspaces.sh)
(defwidget workspaces [monitor]
  (box :class "workspaces"
       :orientation "v"
       :space-evenly false
       :spacing 4
    (for ws in {workspaces?.[monitor] ?: []}
      (label :class "workspace ${ws.active ? 'active' : ''} ${ws.occupied ? 'occupied' : 'empty'}"
             :text {ws.idx}))))

(defwidget datetime []
  (box :class "datetime"
       :orientation "v"
       :space-evenly false
    (label :text "󰃭")
    (label :text {formattime(EWW_TIME, "%m")})
    (label :text {formattime(EWW_TIME, "%d")})
    (label :text "󰥔")
    (label :text {formattime(EWW_TIME, "%H")})
    (label :text {formattime(EWW_TIME, "%M")})))

; An icon with an optional value below it
(defwidget indicator [class icon ?text]
  (box :class "indicator ${class}"
       :orientation "v"
       :space-evenly false
    (label :class "indicator-icon" :text icon)
    (label :class "indicator-value" :visible {text != ""} :text text)))

; volume follows PipeWire (config/eww-scripts/volume.sh)
(defwidget volume []
  (indicator :class "volume ${volume?.muted == true ? 'muted' : ''}"
             :icon {volume?.icon ?: ""}
             :text "${volume?.value ?: 0}%"))

; brightness follows the backlight (config/eww-scripts/brightness.sh)
(defwidget brightness []
  (indicator :class "brightness"
             :icon "󰃠"
             :text "${brightness}%"))

; EWW_BATTERY holds one entry per battery plus total_avg (null without a battery)
(defwidget battery []
  (battery-indicator
    :capacity {round(EWW_BATTERY?.total_avg ?: 0, 0)}
    :plugged {jq(EWW_BATTERY, '[.[] | select(type == "object") | .status] | any(. != "Discharging")')}))

(defwidget battery-indicator [capacity plugged]
  (indicator :class "battery ${plugged ? 'plugged' : capacity <= 15 ? 'low' : ''}"
             ; one icon per 10%, from empty to full
             :icon {plugged ? "󰂄" : substring("󰂎󰁺󰁻󰁼󰁽󰁾󰁿󰂀󰂁󰂂󰁹", round(capacity / 10, 0), 1)}
             :text "${capacity}%"))

; network follows NetworkManager (config/eww-scripts/network.sh); icon only
(defwidget network []
  (indicator :class "network ${network?.state ?: ''}"
             :icon {network?.icon ?: ""}))

; OSD values are pushed by eww-osd (config/eww-scripts/osd.sh)
(defvar osd_icon "")
(defvar osd_value 0)
(defvar osd_muted false)

(defwindow osd
  :geometry (geometry :x "0px"
                      :y "64px"
                      :width "320px"
                      :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable "none"
  :namespace "eww-osd"
  (osd))

(defwidget osd []
  (box :class "osd ${osd_muted ? 'muted' : ''}"
       :orientation "h"
       :space-evenly false
       :spacing 14
    (label :class "osd-icon" :text osd_icon)
    (progress :class "osd-gauge"
              :hexpand true
              :valign "center"
              :value osd_value)
    (label :class "osd-value" :text "${osd_value}%")))

; System monitor popup, toggled by eww-popup (config/eww-scripts/popup.sh).
; Values come from eww's built-in variables.
(defwindow sysmon
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "360px"
                      :anchor "center")
  :stacking "overlay"
  :exclusive false
  :focusable "none"
  :namespace "eww-sysmon"
  (sysmon))

(defwidget sysmon []
  (box :class "popup"
       :orientation "v"
       :space-evenly false
       :spacing 14
    (label :class "popup-title" :halign "start" :text "System")
    (metric :icon "" :name "CPU"
            :percent {round(EWW_CPU.avg, 0)}
            :text "${round(EWW_CPU.avg, 0)}%")
    (metric :icon "" :name "Memory"
            :percent {round(EWW_RAM.used_mem_perc, 0)}
            :text "${round(EWW_RAM.used_mem / 1073741824, 1)} / ${round(EWW_RAM.total_mem / 1073741824, 1)} GiB")
    (metric :icon "󰋊" :name "Disk"
            :percent {round(EWW_DISK["/"].used_perc, 0)}
            :text "${round((EWW_DISK["/"].total - EWW_DISK["/"].free) / 1073741824, 0)} / ${round(EWW_DISK["/"].total / 1073741824, 0)} GiB")
    (metric :icon "󰔏" :name "Temp"
            :percent {round(jq(EWW_TEMPS, "[.[] | tonumber] | max"), 0)}
            :text "${round(jq(EWW_TEMPS, "[.[] | tonumber] | max"), 0)}°C")))

(defwidget metric [icon name percent text]
  (box :class "metric ${percent >= 85 ? 'hot' : ''}"
       :orientation "v"
       :space-evenly false
       :spacing 6
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "metric-icon" :text icon)
      (label :class "metric-name" :halign "start" :hexpand true :text name)
      (label :class "metric-text" :text text))
    (progress :class "gauge" :value percent)))
